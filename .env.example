# YallaBalagan Environment Variables Template
# Copy this file to .env.prod and .env.dev and fill in your values

##############################################################################
# TICKET SERVICE
##############################################################################

# Telegram Bot for Ticket Admin
TELEGRAM_BOT_TOKEN_TICKET=bot123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# All-Pay Payment Integration
ALLPAY_WEBHOOK_SECRET=your-allpay-webhook-secret

# Email (must be verified in SES)
SENDER_EMAIL_TICKET=tickets@yallabalagan.org

# Analytics
GA4_ID=G-XXXXXXXXXX
FB_PIXEL_ID=123456789012345

##############################################################################
# EVENTS SITE
##############################################################################

# Notion Integration
NOTION_TOKEN=secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NOTION_DATABASE_ID_EVENTS=1234567890abcdef1234567890abcdef

# Telegram Bot for Events Admin
TELEGRAM_BOT_TOKEN_EVENTS=bot234567:XYZ-ABC2345ghIkl-zyx68W3v2u234ew22

# Allowed Telegram User IDs (comma-separated)
ALLOWED_USERS_EVENTS=123456789,987654321

# YouTube (optional)
YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
YOUTUBE_PLAYLIST_ID=PLxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ticket Service Integration (optional)
TICKET_API_URL=https://xxxxx.execute-api.eu-north-1.amazonaws.com

##############################################################################
# DONATE SITE
##############################################################################

# Notion Integration (3 databases)
NOTION_DATABASE_ID_TALENTS=2234567890abcdef2234567890abcdef
NOTION_DATABASE_ID_PRODUCTS=3234567890abcdef3234567890abcdef
NOTION_DATABASE_ID_PROJECTS=4234567890abcdef4234567890abcdef

# Telegram Bot for Donate Admin
TELEGRAM_BOT_TOKEN_DONATE=bot345678:QWE-RTY3456ghIkl-zyx79W4v3u345ew33

# Allowed Telegram User IDs (comma-separated)
ALLOWED_USERS_DONATE=123456789,987654321

# Email
SENDER_EMAIL_DONATE=yalla@yallabalagan.org
ADMIN_EMAIL_DONATE=yalla@yallabalagan.org

##############################################################################
# NEWSLETTER
##############################################################################

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEWSLETTER_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Email (must be verified in SES)
SENDER_EMAIL_NEWSLETTER=newsletter@yallabalagan.org

# Admin Password (optional, basic auth)
NEWSLETTER_ADMIN_PASSWORD=your-strong-password-here

##############################################################################
# NOTES
##############################################################################

# How to get Notion Token:
# 1. Go to https://www.notion.so/my-integrations
# 2. Create new integration
# 3. Copy the "Internal Integration Token"

# How to get Notion Database ID:
# 1. Open your Notion database in browser
# 2. URL format: https://www.notion.so/workspace/{database_id}?v=...
# 3. Copy the {database_id} part

# How to get Telegram Bot Token:
# 1. Message @BotFather on Telegram
# 2. Use /newbot command
# 3. Copy the token

# How to get Telegram User ID:
# 1. Message @userinfobot on Telegram
# 2. It will reply with your user ID

# How to verify SES email:
# aws ses verify-email-identity --email-address your@email.com --profile yallabalagan-prod
